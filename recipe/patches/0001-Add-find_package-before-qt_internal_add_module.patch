From: Andrii Osipov <aosipov@anaconda.com>
Date: Thu, 29 Jan 2026 02:42:38 -0800
Subject: [PATCH] Add find_package before qt_internal_add_module

---
 src/compositor/CMakeLists.txt | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/compositor/CMakeLists.txt b/src/compositor/CMakeLists.txt
index fa3251b..8705658 100644
--- a/src/compositor/CMakeLists.txt
+++ b/src/compositor/CMakeLists.txt
@@ -1,6 +1,9 @@
 # Copyright (C) 2022 The Qt Company Ltd.
 # SPDX-License-Identifier: BSD-3-Clause
 
+# Explicitly find WaylandGlobalPrivate from qtbase before using it
+find_package(Qt6 REQUIRED COMPONENTS WaylandGlobalPrivate)
+
 include(QtWaylandSetup)
 qt_internal_get_wayland_protocols_dir(protocols_dir)
 qt_internal_get_wayland_extensions_dir(extensions_dir)
