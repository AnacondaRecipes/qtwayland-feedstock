From fbecf412eccd2b81ef8fc16950d847214e7655ec Mon Sep 17 00:00:00 2001
From: Andrii Osipov <aosipov@anaconda.com>
Date: Thu, 29 Jan 2026 05:04:09 -0800
Subject: [PATCH] Fix internal target exports in Wayland modules

---
 src/compositor/CMakeLists.txt                                 | 1 -
 src/hardwareintegration/compositor/wayland-egl/CMakeLists.txt | 2 +-
 2 files changed, 1 insertion(+), 2 deletions(-)

diff --git a/src/compositor/CMakeLists.txt b/src/compositor/CMakeLists.txt
index 8705658..a7a779f 100644
--- a/src/compositor/CMakeLists.txt
+++ b/src/compositor/CMakeLists.txt
@@ -79,7 +79,6 @@ qt_internal_add_module(WaylandCompositor
     PRIVATE_MODULE_INTERFACE
         Qt::CorePrivate
         Qt::GuiPrivate
-        Qt::WaylandGlobalPrivate
     PRIVATE_HEADER_FILTERS
         "^qwayland-.*\.h|^wayland-.*-protocol\.h"
     ATTRIBUTION_FILE_DIR_PATHS
diff --git a/src/hardwareintegration/compositor/wayland-egl/CMakeLists.txt b/src/hardwareintegration/compositor/wayland-egl/CMakeLists.txt
index f319285..1575f2d 100644
--- a/src/hardwareintegration/compositor/wayland-egl/CMakeLists.txt
+++ b/src/hardwareintegration/compositor/wayland-egl/CMakeLists.txt
@@ -17,10 +17,10 @@ qt_internal_add_module(WaylandEglCompositorHwIntegrationPrivate
         EGL::EGL
         Wayland::Egl
         Wayland::Server
+        Qt::WaylandCompositorPrivate
     PUBLIC_LIBRARIES
         Qt::Core
         Qt::Gui
-        Qt::WaylandCompositorPrivate
     NO_GENERATE_CPP_EXPORTS
 )
 
